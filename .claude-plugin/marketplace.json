{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "test-errant-marketplace",
  "description": "Private test marketplace that intentionally contains a malformed plugin entry (invalid author.email) for parser error testing",
  "owner": {
    "name": "jaysunmah",
    "email": "test@example.com"
  },
  "plugins": [
    {
      "name": "test-lsp-plugin",
      "description": "Test LSP plugin for TypeScript/JavaScript language server",
      "version": "1.0.0",
      "author": {
        "name": "Test Author",
        "email": "test@example.com"
      },
      "source": "./plugins/test-lsp-plugin",
      "category": "development",
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact"
          }
        }
      }
    },
    {
      "name": "example-plugin",
      "description": "A comprehensive example plugin demonstrating all Claude Code extension options",
      "author": {
        "name": "Test Author",
        "email": "test@example.com"
      },
      "source": "./plugins/example-plugin",
      "category": "development",
      "homepage": "https://github.com/jaysunmah/test-errant-marketplace/tree/main/plugins/example-plugin"
    },
    {
      "name": "code-review",
      "description": "Automated code review for pull requests using multiple specialized agents",
      "author": {
        "name": "Test Author",
        "email": "test@example.com"
      },
      "source": "./plugins/code-review",
      "category": "productivity",
      "homepage": "https://github.com/jaysunmah/test-errant-marketplace/tree/main/plugins/code-review"
    },
    {
      "name": "test-integration",
      "description": "Test external integration plugin with MCP server configuration",
      "category": "productivity",
      "source": "./external_plugins/test-integration",
      "homepage": "https://github.com/jaysunmah/test-errant-marketplace/tree/main/external_plugins/test-integration"
    },
    {
      "name": "jason-test-datadog",
      "description": "Test plugin 2 for validating marketplace plugin registration",
      "author": {
        "name": "Test Author",
        "email": "test@example.com"
      },
      "source": "./plugins/cursor-datadog-plugin",
      "category": "development",
      "homepage": "https://github.com/jaysunmah/test-errant-marketplace/tree/main/plugins/test-2"
    },
    {
      "name": "test-2",
      "description": "Test plugin 2 for validating marketplace plugin registration",
      "author": {
        "name": "Test Author",
        "email": "test@example.com"
      },
      "source": "./plugins/test-2",
      "category": "development",
      "homepage": "https://github.com/jaysunmah/test-errant-marketplace/tree/main/plugins/test-2"
    },
    {
      "name": "test-3",
      "description": "Test plugin stored in a deeply nested non-standard directory",
      "version": "1.0.0",
      "author": {
        "name": "Test Author",
        "email": "test@example.com"
      },
      "category": "development",
      "source": "./external_plugins/experimental/deeply/nested/test-3",
      "homepage": "https://github.com/jaysunmah/test-errant-marketplace/tree/main/external_plugins/experimental/deeply/nested/test-3"
    },
    {
      "name": "test-git-subdir",
      "description": "Plugin from dedicated repo jaysunmah/test-git-subdir, fetched via git-subdir (sparse clone of path plugin/)",
      "author": {
        "name": "jaysunmah",
        "email": "test@example.com"
      },
      "category": "development",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/jaysunmah/test-git-subdir.git",
        "path": "plugin",
        "ref": "main"
      },
      "homepage": "https://github.com/jaysunmah/test-git-subdir/tree/main/plugin"
    },
    {
      "name": "test-github-plugin",
      "description": "Dedicated repo for testing marketplace source type github (owner/repo clone)",
      "author": {
        "name": "jaysunmah",
        "email": "test@example.com"
      },
      "category": "development",
      "source": {
        "source": "github",
        "repo": "jaysunmah/test-github-plugin"
      },
      "homepage": "https://github.com/jaysunmah/test-github-plugin"
    },
    {
      "name": "test-url-plugin",
      "description": "Dedicated repo for testing marketplace source type url (HTTPS git URL clone)",
      "author": {
        "name": "jaysunmah",
        "email": "test@example.com"
      },
      "category": "development",
      "source": {
        "source": "url",
        "url": "https://github.com/jaysunmah/test-url-plugin.git"
      },
      "homepage": "https://github.com/jaysunmah/test-url-plugin"
    },
    {
      "name": "errant-plugin",
      "description": "Plugin entry with an intentionally invalid author.email for marketplace parser testing",
      "author": {
        "name": "Errant Test Author",
        "email": "not-an-email"
      },
      "source": "./plugins/errant-plugin",
      "category": "development",
      "homepage": "https://github.com/jaysunmah/test-errant-marketplace/tree/main/plugins/errant-plugin"
    }
  ]
}
